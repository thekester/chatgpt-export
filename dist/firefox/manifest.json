{
  "manifest_version": 3,
  "name": "ChatGPT Markdown Export",
  "version": "0.6.11",
  "description": "Export and archive ChatGPT conversations as Markdown, HTML, JEX, or ZIP with images, files, sources, branches, and self-contained Markdown.",
  "homepage_url": "https://github.com/thekester/chatgpt-export",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Export as Markdown",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "lib/marked.umd.js",
        "src/zip.js",
        "src/render.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "chatgpt-md-export@example.org",
      "strict_min_version": "121.0"
    }
  },
  "permissions": [
    "storage",
    "scripting"
  ]
}
